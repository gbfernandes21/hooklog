# HookLog: copie este arquivo para .env e preencha os valores.
# O .env não é versionado.
#
# ADMIN_EMAIL e ADMIN_SENHA são obrigatórios. Sem eles, o docker compose e
# os dois serviços se recusam a iniciar. A senha do ADMIN deve ter ao menos
# 8 caracteres e o e-mail precisa ser válido.
ADMIN_EMAIL=
ADMIN_SENHA=

# --- Compartilhadas (raiz, lidas pelo docker compose) ---
SENHA_BANCO_MONITORAMENTO=troque-me
SENHA_BANCO_TRANSPORTADORA=troque-me
SEGREDO_WEBHOOK=troque-me
CHAVE_API_SERVICO=troque-me
SEGREDO_JWT_MONITORAMENTO=troque-me
SEGREDO_JWT_TRANSPORTADORA=troque-me

# --- Monitoramento (porta 8000) ---
# URL_BANCO: padrão postgresql+asyncpg://usuario_monitoramento:<SENHA_BANCO_MONITORAMENTO>@monitoramento-db:5432/monitoramento
CAMINHO_RAIZ=/api
# SEGREDO_JWT usa SEGREDO_JWT_MONITORAMENTO.
MINUTOS_EXPIRACAO_TOKEN=60
# SEGREDO_WEBHOOK usa SEGREDO_WEBHOOK.
TOLERANCIA_TIMESTAMP_WEBHOOK_SEGUNDOS=300
URL_TRANSPORTADORA=http://transportadora:8001
# CHAVE_API_TRANSPORTADORA usa CHAVE_API_SERVICO.
TIMEOUT_TRANSPORTADORA_SEGUNDOS=3
URL_PUBLICA_WEBHOOK=http://monitoramento:8000/webhooks/transportadora
INTERVALO_ROTINA_REGISTRO_SEGUNDOS=5
MAX_TENTATIVAS_REGISTRO=8
BASE_BACKOFF_REGISTRO_SEGUNDOS=5
TETO_BACKOFF_REGISTRO_SEGUNDOS=60
CONCORRENCIA_MAXIMA_REGISTRO=5
TAMANHO_POOL_BANCO=10

# --- Transportadora (porta 8001) ---
# URL_BANCO: padrão postgresql+asyncpg://usuario_transportadora:<SENHA_BANCO_TRANSPORTADORA>@transportadora-db:5432/transportadora
# CAMINHO_RAIZ (/transportadora) e SEGREDO_JWT (SEGREDO_JWT_TRANSPORTADORA)
# são definidos pelo docker compose para este serviço.
# CHAVE_API_SERVICO e SEGREDO_WEBHOOK usam os valores compartilhados acima.
MAX_TENTATIVAS_WEBHOOK=5
BASE_BACKOFF_WEBHOOK_SEGUNDOS=1
INTERVALO_ROTINA_WEBHOOK_SEGUNDOS=1
TIMEOUT_ENVIO_WEBHOOK_SEGUNDOS=5
CONCORRENCIA_MAXIMA_WEBHOOK=5
# MINUTOS_EXPIRACAO_TOKEN (60) e TAMANHO_POOL_BANCO (10) também são
# definidos pelo docker compose para este serviço.
